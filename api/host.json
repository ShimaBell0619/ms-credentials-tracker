{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Warning",
      "Function": "Warning"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 50,
      "maxConcurrentRequests": 25,
      "dynamicThrottlesEnabled": true
    }
  }
}
